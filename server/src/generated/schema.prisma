generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------
// ENUMS
// ----------------------------------------

enum Role {
  USER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommunityRole {
  OWNER
  MODERATOR
  MEMBER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum DiscoverCategory {
  FOOD
  FESTIVAL
  CRAFT
  HERITAGE
  WILDLIFE
}

enum NotificationType {
  APPROVAL
  REWARD
  BADGE
  ANNOUNCEMENT
  ALERT
}

// ----------------------------------------
// USER & CORE MODELS
// ----------------------------------------

model User {
  id           String  @id @default(uuid())
  firebaseUid  String  @unique
  email        String? @unique
  name         String
  avatar       String?
  title        String?
  bio          String?
  background   String?
  rewardPoints Int     @default(0)
  badges       Int     @default(0)
  role         Role    @default(USER)

  // Relationships
  communityPosts       CommunityPost[]
  postComments         PostComment[]
  journeys             Journey[]
  galleryItems         GalleryItem[]
  notifications        Notification[]
  communitiesCreated   Community[]       @relation("CommunityCreator")
  communityMemberships CommunityMember[]
  categoryStories      CategoryStory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String
  message String
  unread  Boolean          @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------
// DESTINATIONS & DISTRICTS
// ----------------------------------------

model District {
  id                String   @id @default(uuid())
  name              String   @unique
  image             String
  tagline           String?
  introduction      String?
  richHistory       String?
  topTouristName    String?
  topTouristDetails String?
  howToReachAir     String?
  howToReachRail    String?
  howToReachRoad    String?
  whyInTouristList  String[]

  seasonalVisits SeasonRow[]
  topAttractions TopAttraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeasonRow {
  id       String @id @default(uuid())
  season   String
  months   String
  weather  String
  whyVisit String

  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
}

model TopAttraction {
  id               String  @id @default(uuid())
  name             String
  image            String
  description      String
  shortDescription String?
  rating           Float?
  bestTime         String?

  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
}

// ----------------------------------------
// DISCOVER (Unified Categories)
// ----------------------------------------

model DiscoverItem {
  id              String           @id @default(uuid())
  title           String
  category        DiscoverCategory
  image           String
  description     String
  featured        Boolean          @default(false)
  author          String?          @default("Admin")
  district        String           @default("Bihar")
  status          ApprovalStatus   @default(PENDING)
  longDescription String?          @db.Text
  videoUrl        String?
  galleryImages   String[]         @default([])
  extendedDetails String[]         @default([])
  publicId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tribe {
  id              String  @id @default(uuid())
  hindiName       String
  englishName     String
  shortDesc       String
  image           String
  leftTitle       String?
  leftDesc        String?
  rightTitle      String?
  rightDesc       String?
  bottomDesc      String?
  cultureSections Json? // Rich JSON structure for Traditions, Personalities, Food, etc.

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TribeVideo {
  id              String         @id @default(uuid())
  title           String?
  caption         String?        @db.Text
  videoUrl        String         @db.Text
  uploaderName    String         @default("Explorer")
  description     String?        @db.Text
  tribeId         String
  tribeName       String
  thumbnail       String?
  duration        String?
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?        @db.Text
  userId          String?
  publicId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Personality {
  id          String         @id @default(uuid())
  name        String
  category    String
  district    String
  description String
  imageUrl    String
  fullBio     String?
  author      String?        @default("Admin")
  status      ApprovalStatus @default(PENDING)
  publicId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TribalArticle {
  id            String   @id @default(uuid())
  headline      String
  description   String
  image         String
  images        String[]
  author        String
  tribe         String
  publishedDate String?
  readTime      Int?
  tags          String[]
  location      String

  status ApprovalStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------
// COMMUNITY & USER SUBMISSIONS
// ----------------------------------------

model Community {
  id               String         @id @default(uuid())
  slug             String         @unique @default(uuid())
  name             String         @unique
  shortDescription String         @default("")
  description      String
  bannerImageUrl   String
  logoImageUrl     String         @default("")
  category         String?
  rules            String[]
  postsCount       Int            @default(0)
  membersCount     Int            @default(0)
  isActive         Boolean        @default(true)
  isFeatured       Boolean        @default(false)
  status           ApprovalStatus @default(PENDING)

  createdBy String?
  creator   User?   @relation("CommunityCreator", fields: [createdBy], references: [id])

  posts   CommunityPost[]
  members CommunityMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunityMember {
  id          String        @id @default(uuid())
  communityId String
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CommunityRole @default(MEMBER)

  joinedAt DateTime @default(now())

  @@unique([communityId, userId])
}

model CommunityPost {
  id       String   @id @default(uuid())
  title    String
  content  String
  likes    Int      @default(0)
  replies  Int      @default(0)
  views    Int      @default(0)
  viewedBy String[] @default([])

  mediaUrl  String?
  mediaType MediaType?
  pollData  Json?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  comments PostComment[]

  status ApprovalStatus @default(APPROVED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostComment {
  id      String @id @default(uuid())
  content String

  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  children PostComment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Journey {
  id               String   @id @default(uuid())
  title            String
  shortDesc        String?
  description      String
  overviewText     String?
  image            String?
  duration         String?
  tripDuration     String?
  budget           String?
  price            String?
  district         String?
  stops            String[]
  phone            String?
  whatsapp         String?
  difficulty       String?
  bestTime         String?
  groupSize        String?
  transportation   String?
  startPoint       String?
  endPoint         String?
  emergencyContact String?
  email            String?
  quote            String?
  galleryImages    String[]
  timeline         Json?

  // New fields from CreateJourney form
  category         String?
  companyName      String?
  rating           Float?
  userRating       Float?
  highlights       String[]
  includedServices String[]
  excludedServices String[]
  googleMapsLink   String?

  // Guide fields
  guideName       String?
  guideImage      String?
  guideExperience String?
  guideLanguages  String[]
  guideIntro      String?
  guidePhone      String?
  guideEmail      String?
  guideWhatsapp   String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  status   ApprovalStatus @default(PENDING)
  publicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id          String @id @default(uuid())
  title       String
  description String
  image       String
  category    String
  likes       Int    @default(0)
  views       Int    @default(0)

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  status   ApprovalStatus @default(PENDING)
  publicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------
// MARKETPLACE
// ----------------------------------------

model MarketplaceProduct {
  id           String   @id @default(uuid())
  businessName String
  productName  String
  category     String
  image        String
  images       String[]
  description  String
  address      String?
  website      String?
  mapLink      String?
  contact      String?
  email        String?

  status   ApprovalStatus @default(PENDING)
  publicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------
// CONFIGURATION
// ----------------------------------------

model SiteSettings {
  id                Int    @id @default(1)
  heroEyebrow       String @default("The Cradle of Enlightenment. The Soul of Heritage.")
  heroTitle         String @default("Unveil the Eternal Heritage of")
  heroSubtitle      String @default("Bihar")
  heroDescription   String @default("Step into a timeless realm of sacred landmarks, living traditions, authentic flavors, and enduring stories.")
  heroImage         String @default("")
  heroVideo         String @default("")
  statPlaces        String @default("500+")
  statDistricts     String @default("38")
  statCulturalSites String @default("100+")
  statFestivals     String @default("50+")
  statTourists      String @default("1000+")
  footerAbout       String @default("Bihar Darshan is a digital platform to explore the rich cultural heritage, historical landmarks, and vibrant communities of Bihar.")

  updatedAt DateTime @updatedAt
}

model CustomCategory {
  id          String         @id @default(uuid())
  title       String
  description String?
  image       String
  district    String         @default("BIHAR")
  badgeText   String?
  status      ApprovalStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CardMedia {
  id         String    @id @default(uuid())
  itemId     String
  url        String
  mediaType  MediaType @default(IMAGE)
  title      String?
  caption    String?
  likes      Int       @default(0)
  dislikes   Int       @default(0)
  likedBy    String[]  @default([])
  dislikedBy String[]  @default([])
  uploadedBy String?   @default("Anonymous")
  publicId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------
// CATEGORIES & SUB-CATEGORIES & STORIES
// ----------------------------------------

model Category {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  description String?        @db.Text
  image       String
  icon        String?
  status      ApprovalStatus @default(APPROVED)

  subcategories SubCategory[]
  stories       CategoryStory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubCategory {
  id          String  @id @default(uuid())
  title       String
  slug        String
  description String? @db.Text
  image       String
  icon        String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  stories CategoryStory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
}

model CategoryStory {
  id           String         @id @default(uuid())
  title        String
  content      String         @db.Text
  mediaUrl     String?
  mediaType    MediaType      @default(IMAGE)
  mediaFiles   Json?
  authorName   String         @default("Anonymous")
  authorAvatar String?
  district     String         @default("Bihar")
  views        Int            @default(0)
  viewedBy     String[]       @default([])
  likes        Int            @default(0)
  dislikes     Int            @default(0)
  likedBy      String[]       @default([])
  dislikedBy   String[]       @default([])
  status       ApprovalStatus @default(PENDING)
  publicId     String?

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  subcategoryId String
  subcategory   SubCategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
